     1                                  ; SNAP.COM -- real-mode INT 10h snapshot TSR for capturing the ORIGINAL game's frames.
     2                                  ;
     3                                  ; Why: dosbox-staging 0.83 has no image capture command (docs/46 measured five host-side routes dead), and the
     4                                  ; game takes the timer IRQ into its protected-mode IDT, so a tick-driven TSR never runs (also docs/46). What the
     5                                  ; game cannot avoid is the real-mode video interrupt: its protected-mode code reaches VESA through DPMI's
     6                                  ; "call real-mode interrupt" service, which dispatches the REAL-MODE INT 10h vector. Hooking that vector gives a
     7                                  ; trigger at every mode set, and a hook of the window-position call gives one at every framebuffer-window slide.
     8                                  ;
     9                                  ; Record layout appended to SNAP.BIN (little endian):
    10                                  ;   0  'N','G','H','1'
    11                                  ;   4  u8  AH of the intercepted call
    12                                  ;   5  u8  AL of the intercepted call
    13                                  ;   6  u32 ECX at entry (VESA 4F05: window position)
    14                                  ;   10 u32 EDX at entry (VESA 4F05: window type in DL)
    15                                  ;   14 u32 sequence number
    16                                  ;   18 u32 VGA window bytes written (65536)
    17                                  ;   22 u8[65536] A000:0 .. A000:FFFF
    18                                  ;
    19                                  ; Build: nasm -f bin -o SNAP.COM snapr5.asm
    20                                  
    21                                  BITS 16
    22                                  ORG 0x100
    23                                  
    24                                  start:
    25                                      ; ---- create/truncate SNAP.BIN --------------------------------------------
    26 00000000 B43C                        mov  ah, 0x3C
    27 00000002 31C9                        xor  cx, cx
    28 00000004 BA0F02                      mov  dx, fname - start + 0x100
    29 00000007 CD21                        int  0x21
    30 00000009 722C                        jc   short quit
    31 0000000B A3[E500]                    mov  [handle], ax
    32                                  
    33                                      ; ---- chain vector for INT 10h -------------------------------------------
    34 0000000E FA                          cli
    35 0000000F 31C0                        xor  ax, ax
    36 00000011 8EC0                        mov  es, ax
    37 00000013 268B1E4000                  mov  bx, [es:0x40]
    38 00000018 891E[EB00]                  mov  [old_off], bx
    39 0000001C 268B1E4200                  mov  bx, [es:0x42]
    40 00000021 891E[ED00]                  mov  [old_seg], bx
    41 00000025 26C70640003C01              mov  word [es:0x40], my10 - start + 0x100
    42 0000002C 268C0E4200                  mov  word [es:0x42], cs
    43 00000031 FB                          sti
    44                                  
    45                                      ; ---- stay resident -------------------------------------------------------
    46 00000032 BA2200                      mov  dx, (end - start + 0xF + 0x100) >> 4
    47 00000035 CD27                        int  0x27
    48                                  
    49                                  quit:
    50 00000037 B44C                        mov  ah, 0x4C
    51 00000039 CD21                        int  0x21
    52 0000003B C3                          ret
    53                                  
    54                                  ; ---- the hook ----------------------------------------------------------------
    55                                  my10:
    56 0000003C 60                          pusha
    57 0000003D 06                          push es
    58 0000003E 1E                          push ds
    59 0000003F 55                          push bp
    60 00000040 89E5                        mov  bp, sp                     ; not used, keeps the frame explicit
    61 00000042 2EA3[EF00]                  mov  [cs:save_ax], ax
    62 00000046 2E66890E[F100]              mov  [cs:save_cx], ecx
    63 0000004C 2E668916[F500]              mov  [cs:save_dx], edx
    64                                  
    65 00000052 2EFF1E[EB00]                call far word [cs:old_off]      ; run the real video handler first (0xFF 0x1E ...)
    66                                  
    67 00000057 2EA1[EF00]                  mov  ax, [cs:save_ax]
    68 0000005B 80FC4F                      cmp  ah, 0x4F
    69 0000005E 750A                        jne  short .plain
    70 00000060 3C02                        cmp  al, 0x02                   ; VESA set mode
    71 00000062 740B                        je   short .grab
    72 00000064 3C05                        cmp  al, 0x05                   ; VESA set window position
    73 00000066 7407                        je   short .grab
    74 00000068 EB08                        jmp  short .done
    75                                  .plain:
    76 0000006A 80FC00                      cmp  ah, 0x00                   ; BIOS set mode
    77 0000006D 7503                        jne  short .done
    78                                  .grab:
    79 0000006F E80500                      call dump_window
    80                                  
    81                                  .done:
    82 00000072 5D                          pop  bp
    83 00000073 1F                          pop  ds
    84 00000074 07                          pop  es
    85 00000075 61                          popa
    86 00000076 CF                          iret
    87                                  
    88                                  ; ---- append the 64 KiB window plus its header --------------------------------
    89                                  dump_window:
    90 00000077 60                          pusha
    91 00000078 1E                          push ds
    92 00000079 06                          push es
    93 0000007A 8CC8                        mov  ax, cs
    94 0000007C 8ED8                        mov  ds, ax
    95 0000007E A1[E700]                    mov  ax, [seq]
    96 00000081 40                          inc  ax
    97 00000082 A3[E700]                    mov  [seq], ax
    98                                  
    99 00000085 BEF901                      mov  si, hdr - start + 0x100
   100 00000088 C6044E                      mov  byte [si+0], 'N'
   101 0000008B C6440147                    mov  byte [si+1], 'G'
   102 0000008F C6440248                    mov  byte [si+2], 'H'
   103 00000093 C6440331                    mov  byte [si+3], '1'
   104 00000097 A1[EF00]                    mov  ax, [save_ax]
   105 0000009A 886404                      mov  byte [si+4], ah
   106 0000009D 884405                      mov  byte [si+5], al
   107 000000A0 66A1[F100]                  mov  eax, [save_cx]
   108 000000A4 66894406                    mov  [si+6], eax
   109 000000A8 66A1[F500]                  mov  eax, [save_dx]
   110 000000AC 6689440A                    mov  [si+10], eax
   111 000000B0 66A1[E700]                  mov  eax, [seq]
   112 000000B4 6689440E                    mov  [si+14], eax
   113 000000B8 66C7441200000100            mov  dword [si+18], 65536
   114                                  
   115 000000C0 B440                        mov  ah, 0x40
   116 000000C2 8B1E[E500]                  mov  bx, [handle]                ; INT 21h/40h: BX = handle, DS:DX = buffer, CX = count
   117 000000C6 BAF901                      mov  dx, hdr - start + 0x100
   118 000000C9 B91600                      mov  cx, 22
   119 000000CC CD21                        int  0x21                        ; header
   120                                  
   121                                      ; the payload comes straight out of the VGA window: DS:DX must point at A000:0
   122 000000CE B440                        mov  ah, 0x40
   123 000000D0 8B1E[E500]                  mov  bx, [handle]
   124 000000D4 1E                          push ds
   125 000000D5 B800A0                      mov  ax, 0xA000
   126 000000D8 8ED8                        mov  ds, ax
   127 000000DA 31D2                        xor  dx, dx
   128 000000DC B90000                      mov  cx, 65536
   128          ******************       warning: word exceeds bounds [-w+number-overflow]
   129 000000DF CD21                        int  0x21                        ; 64 KiB of the framebuffer window
   130 000000E1 1F                          pop  ds
   131 000000E2 07                          pop  es
   132 000000E3 61                          popa
   133 000000E4 C3                          ret
   134                                  
   135                                  ; ---- data -------------------------------------------------------------------
   136 000000E5 0000                    handle  dw 0
   137 000000E7 00000000                seq     dd 0
   138 000000EB 0000                    old_off dw 0
   139 000000ED 0000                    old_seg dw 0
   140 000000EF 0000                    save_ax dw 0
   141 000000F1 00000000                save_cx dd 0
   142 000000F5 00000000                save_dx dd 0
   143 000000F9 00<rep 16h>             hdr     times 22 db 0
   144 0000010F 534E41502E42494E00      fname   db 'SNAP.BIN', 0
   145                                  end:
